        { "type": "textarea", "id": "text", "label": "Tekst (uden citationstegn)", "default": "Sidder perfekt hele kampen." },
        { "type": "text", "id": "name", "label": "Navn", "default": "Mikkel T." },
        { "type": "text", "id": "meta", "label": "Sport/niveau", "default": "Håndbold, 2. div." }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "NA PDP Anmeldelser",
      "category": "Product",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "text": "Landede på hoften i weekendens kamp — rejste mig bare igen. Første sæson uden blå mærker.",
            "name": "Mikkel T.",
            "meta": "Håndbold, 2. div."
          }
        },
        {
          "type": "review",
          "settings": {
            "text": "Sidder perfekt hele kampen. Man glemmer, man har dem på — indtil man rammer gulvet.",
            "name": "Cecilie R.",
            "meta": "Håndbold, U19 elite"
          }
        },
        {
          "type": "review",
          "settings": {
            "text": "Købte dem efter en knæskade. Tryghed i hver eneste finte — og kvaliteten holder.",
            "name": "Anders K.",
            "meta": "Basketball"
          }
        }
      ]
    }
  ]
}
{% endschema %}
