{% schema %}
{
  "name": "NA Sport Collections",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow tekst",
      "default": "Shop efter sport"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Overskrift",
      "default": "<p>Find udstyr til <em>din sport</em></p>",
      "info": "Brug kursiv (italic) for at gøre teksten grøn."
    },
    {
      "type": "collection_list",
      "id": "collection_list",
      "label": "Vælg kollektioner",
      "limit": 6
    }
  ],
  "presets": [
    {
      "name": "NA Sport Collections",
      "category": "Collection"
    }
  ]
}
{% endschema %}

<style>
  .na-sport {
    padding: 64px 40px;
    background: #2a2a2a;
    border-bottom: 1px solid #2e3d32;
    font-family: -apple-system, BlinkMacSystemFont, 'Inter', 'Segoe UI', sans-serif;
  }
  .na-sport-inner {
    max-width: 1200px;
    margin: 0 auto;
  }
  .na-sport-header {
    margin-bottom: 36px;
  }
  .na-sport-eyebrow {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #3d7a52;
    margin: 0 0 10px 0;
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .na-sport-eyebrow::before {
    content: '';
    display: block;
    width: 24px;
    height: 2px;
    background: #3d7a52;
    flex-shrink: 0;
  }
  .na-sport-title {
    font-size: 36px;
    font-weight: 900;
    line-height: 1.1;
    color: #ffffff;
    margin: 0;
    letter-spacing: -0.02em;
  }
  .na-sport-title p {
    margin: 0;
  }
  .na-sport-title em {
    font-style: normal;
    color: #3d7a52;
  }
  .na-sport-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 12px;
  }
  .na-sport-card {
    display: block;
    text-decoration: none;
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    aspect-ratio: 3 / 4;
    background: #253020;
    border: 1px solid #2e3d32;
    transition: transform 0.25s ease, border-color 0.25s ease;
  }
  .na-sport-card:hover {
    transform: translateY(-4px);
    border-color: #3a5040;
  }
  .na-sport-card:hover .na-sport-img {
    transform: scale(1.06);
  }
  .na-sport-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.4s ease;
  }
  .na-sport-card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(13, 22, 15, 0.92) 0%,
      rgba(13, 22, 15, 0.55) 40%,
      rgba(13, 22, 15, 0.10) 100%
    );
    pointer-events: none;
  }
  .na-sport-label {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 16px 14px 14px;
    z-index: 1;
  }
  .na-sport-name {
    font-size: 13px;
    font-weight: 800;
    color: #ffffff;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    line-height: 1.2;
    margin: 0 0 4px 0;
    display: block;
  }
  .na-sport-count {
    font-size: 10.5px;
    font-weight: 600;
    color: #3d7a52;
    letter-spacing: 0.04em;
    display: block;
    opacity: 0.85;
  }

  @media screen and (max-width: 900px) {
    .na-sport-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media screen and (max-width: 560px) {
    .na-sport {
      padding: 48px 20px;
    }
    .na-sport-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }
    .na-sport-title {
      font-size: 26px;
    }
  }
</style>

<section class="na-sport">
  <div class="na-sport-inner">

    <div class="na-sport-header">
      {% if section.settings.eyebrow != blank %}
        <p class="na-sport-eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      {% if section.settings.title != blank %}
        <div class="na-sport-title">{{ section.settings.title }}</div>
      {% endif %}
    </div>

    <div class="na-sport-grid">
      {% for collection in section.settings.collection_list %}
        <a href="{{ collection.url }}" class="na-sport-card">
          {% if collection.image != blank %}
            <img
              class="na-sport-img"
              src="{{ collection.image | image_url: width: 600 }}"
              alt="{{ collection.title | escape }}"
              loading="lazy"
            >
          {% elsif collection.products.first and collection.products.first.featured_image != blank %}
            <img
              class="na-sport-img"
              src="{{ collection.products.first.featured_image | image_url: width: 600 }}"
              alt="{{ collection.title | escape }}"
              loading="lazy"
            >
          {% else %}
            <div class="na-sport-img" style="background: #253020;"></div>
          {% endif %}
          
          <div class="na-sport-label">
            <span class="na-sport-name">{{ collection.title }}</span>
            <span class="na-sport-count">{{ collection.all_products_count }} produkter</span>
          </div>
        </a>
      {% else %}
        {% for i in (1..6) %}
          <div class="na-sport-card">
            <div class="na-sport-img" style="background: #253020;"></div>
            <div class="na-sport-label">
              <span class="na-sport-name">Kollektion {{ i }}</span>
              <span class="na-sport-count">0 produkter</span>
            </div>
          </div>
        {% endfor %}
      {% endfor %}
    </div>
  </div>
</section>