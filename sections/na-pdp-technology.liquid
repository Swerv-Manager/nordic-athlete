{%- liquid
  assign tech_image = section.settings.image
  if tech_image == blank and product.media.size > 1
    assign tech_image = product.media[1].preview_image
  endif
-%}

<section class="na-tech" id="teknologi">
  <div class="na-tech__inner">
    <div class="na-tech__media">
      {%- if tech_image -%}
        {{ tech_image | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'na-tech__img', alt: section.settings.heading }}
      {%- endif -%}
      {%- for block in section.blocks -%}
        <span
          class="na-tech__dot"
          style="top: {{ block.settings.dot_y }}%; left: {{ block.settings.dot_x }}%;"
          {{ block.shopify_attributes }}
        >
          {{- forloop.index -}}
        </span>
      {%- endfor -%}
    </div>
    <div class="na-tech__content">
      <span class="na-tech__eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 class="na-tech__heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="na-tech__text">{{ section.settings.text }}</p>
      {%- endif -%}
      <div class="na-tech__zones">
        {%- for block in section.blocks -%}
          <div class="na-tech__zone" {{ block.shopify_attributes }}>
            <span class="na-tech__zone-num">{{ forloop.index }}</span>
            <p class="na-tech__zone-text">
              <strong>{{ block.settings.title }}</strong> — {{ block.settings.text }}
            </p>
          </div>
        {%- endfor -%}
      </div>
      {%- if section.settings.stat_number != blank -%}
        <div class="na-tech__stat">
          <span class="na-tech__stat-num">{{ section.settings.stat_number }}</span>
          <span class="na-tech__stat-text">{{ section.settings.stat_text }}</span>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  .na-tech {
    background: #131c15;
    border-top: 1.5px solid #3a3a3a;
    border-bottom: 1.5px solid #3a3a3a;
  }
  .na-tech__inner {
    max-width: 1280px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  .na-tech__media {
    position: relative;
    min-height: 520px;
    background: radial-gradient(75% 70% at 50% 40%, #2f3a2c, #131c15);
    border-right: 1.5px solid #3a3a3a;
    overflow: hidden;
  }
  .na-tech__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .na-tech__dot {
    position: absolute;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: #3d7a52;
    color: #131c15;
    font-weight: 900;
    font-size: 13px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1.5px solid #69E281;
    transform: translate(-50%, -50%);
  }
  .na-tech__content {
    padding: 64px 56px;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .na-tech__eyebrow {
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #69E281;
  }
  .na-tech__heading {
    margin: 0;
    font-size: clamp(24px, 3vw, 32px);
    font-weight: 900;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: #ffffff;
    line-height: 1.15;
  }
  .na-tech__text {
    margin: 0;
    font-size: 14px;
    line-height: 1.75;
    color: #a8b8ae;
  }
  .na-tech__zones { display: flex; flex-direction: column; gap: 14px; }
  .na-tech__zone { display: flex; gap: 14px; align-items: baseline; }
  .na-tech__zone-num {
    flex: none;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #253020;
    border: 1.5px solid #3d7a52;
    color: #69E281;
    font-weight: 900;
    font-size: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .na-tech__zone-text { margin: 0; font-size: 14px; line-height: 1.7; color: #a8b8ae; }
  .na-tech__zone-text strong { color: #ffffff; }
  .na-tech__stat {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 18px 20px;
    background: #253020;
    border: 1.5px solid #3a3a3a;
    border-radius: 8px;
  }
  .na-tech__stat-num { font-size: 40px; font-weight: 900; color: #69E281; line-height: 1; }
  .na-tech__stat-text { font-size: 13px; line-height: 1.5; color: #a8b8ae; }

  @media (max-width: 749px) {
    .na-tech__inner { grid-template-columns: 1fr; }
    .na-tech__media { min-height: 340px; border-right: none; border-bottom: 1.5px solid #3a3a3a; }
    .na-tech__content { padding: 40px 20px; gap: 18px; }
  }
</style>

{% schema %}
{
  "name": "NA PDP Teknologi",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Billede (tom = produktets 2. billede)"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Body Adjust Technology"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Overskrift",
      "default": "Beskyttelsen bliver, hvor kampen rammer"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Tekst",
      "default": "Tightsene tilpasser sig din kropstemperatur og former sig naturligt efter kroppen. Pasformen føles intuitiv og tætsiddende uden at stramme — så du kan fokusere fuldt ud på dit spil, ikke på dit udstyr."
    },
    {
      "type": "text",
      "id": "stat_number",
      "label": "Stat-tal",
      "default": "20%"
    },
    {
      "type": "text",
      "id": "stat_text",
      "label": "Stat-tekst",
      "default": "mere effektiv stødabsorbering — håndlavet i Europa i premium kvalitet."
    }
  ],
  "blocks": [
    {
      "type": "zone",
      "name": "Beskyttelseszone",
      "settings": [
        { "type": "text", "id": "title", "label": "Titel", "default": "Zone" },
        { "type": "text", "id": "text", "label": "Tekst", "default": "beskyttelse hvor det gælder." },
        { "type": "range", "id": "dot_x", "label": "Prik: vandret (%)", "min": 0, "max": 100, "step": 1, "default": 50 },
        { "type": "range", "id": "dot_y", "label": "Prik: lodret (%)", "min": 0, "max": 100, "step": 1, "default": 50 }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "NA PDP Teknologi",
      "category": "Product",
      "blocks": [
        {
          "type": "zone",
          "settings": {
            "title": "Integreret hoftebeskyttelse",
            "text": "dækket på de vitale punkter ved fald og sammenstød.",
            "dot_x": 32,
            "dot_y": 26
          }
        },
        {
          "type": "zone",
          "settings": {
            "title": "Stabil kompression",
            "text": "støtter musklerne under pres og reducerer træthed ved intensiv træning.",
            "dot_x": 60,
            "dot_y": 50
          }
        },
        {
          "type": "zone",
          "settings": {
            "title": "Knæbeskyttelse",
            "text": "stødabsorberende teknologi der hurtigt vender tilbage til sin oprindelige form.",
            "dot_x": 40,
            "dot_y": 76
          }
        }
      ]
    }
  ]
}
{% endschema %}
