{%- comment -%}
  NA Team — "Menneskerne bag brandet" (Jonas & John). Settings-drevet
  erstatning for den gamle custom-liquid team-sektion på forsiden.
  Personer som blokke: image_picker med fallback-URL (de eksisterende
  eksternt hostede fotos), navn, rolle og bio.
{%- endcomment -%}

{%- liquid
  assign sid = section.id | replace: '__', '-'
  assign photo_class = 'na-team-photo-' | append: sid
-%}

<style>
  #na-team-{{ sid }} {
    padding: 80px 40px;
    background: {% if section.settings.bg_style == 'darker' %}#131c15{% else %}#2a2a2a{% endif %};
    border-top: 1px solid #2e3d32;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }
  .na-team-inner-{{ sid }} {
    max-width: 1200px;
    margin: 0 auto;
  }
  .na-team-header-{{ sid }} {
    max-width: 540px;
    margin-bottom: 48px;
  }
  .na-team-eyebrow-{{ sid }} {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #3d7a52;
    margin: 0 0 10px 0;
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .na-team-eyebrow-{{ sid }}::before {
    content: '';
    display: block;
    width: 24px;
    height: 2px;
    background: #3d7a52;
    flex-shrink: 0;
  }
  .na-team-title-{{ sid }} {
    font-size: 38px;
    font-weight: 900;
    line-height: 1.1;
    color: #ffffff;
    margin: 0 0 14px 0;
    letter-spacing: -0.02em;
  }
  .na-team-title-{{ sid }} p { margin: 0; }
  .na-team-title-{{ sid }} em {
    font-style: normal;
    color: #3d7a52;
  }
  .na-team-subtitle-{{ sid }} {
    font-size: 14.5px;
    color: #a8b8ae;
    line-height: 1.75;
    margin: 0;
  }
  .na-team-grid-{{ sid }} {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }
  .na-team-card-{{ sid }} {
    background: #131c15;
    border: 1.5px solid #3a3a3a;
    border-radius: 8px;
    overflow: hidden;
    display: grid;
    grid-template-columns: 200px 1fr;
    transition: border-color 0.2s;
  }
  .na-team-card-{{ sid }}:hover {
    border-color: #3d7a52;
  }
  .na-team-photo-{{ sid }} {
    width: 100%;
    height: 100%;
    min-height: 260px;
    object-fit: cover;
    object-position: center top;
    display: block;
  }
  .na-team-info-{{ sid }} {
    padding: 28px 24px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .na-team-name-{{ sid }} {
    font-size: 20px;
    font-weight: 900;
    color: #ffffff;
    margin: 0 0 4px 0;
    letter-spacing: -0.01em;
  }
  .na-team-role-{{ sid }} {
    font-size: 9.5px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #3d7a52;
    margin: 0 0 14px 0;
  }
  .na-team-bio-{{ sid }} {
    font-size: 13.5px;
    color: #a8b8ae;
    line-height: 1.7;
    margin: 0;
  }
  .na-team-bio-{{ sid }} p { margin: 0 0 8px 0; }
  .na-team-bio-{{ sid }} p:last-child { margin-bottom: 0; }
  .na-team-bio-{{ sid }} em {
    font-style: italic;
    color: #ffffff;
  }

  @media screen and (max-width: 960px) {
    .na-team-grid-{{ sid }} {
      grid-template-columns: 1fr;
    }
  }
  @media screen and (max-width: 600px) {
    #na-team-{{ sid }} {
      padding: 56px 24px;
    }
    .na-team-card-{{ sid }} {
      grid-template-columns: 1fr;
    }
    .na-team-photo-{{ sid }} {
      height: 280px;
      min-height: auto;
    }
    .na-team-title-{{ sid }} {
      font-size: 28px;
    }
  }
</style>

<section id="na-team-{{ sid }}">
  <div class="na-team-inner-{{ sid }}">

    <div class="na-team-header-{{ sid }}">
      {%- if section.settings.eyebrow != blank -%}
        <p class="na-team-eyebrow-{{ sid }}">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <div class="na-team-title-{{ sid }}">{{ section.settings.title }}</div>
      {%- endif -%}
      {%- if section.settings.subtitle != blank -%}
        <p class="na-team-subtitle-{{ sid }}">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </div>

    <div class="na-team-grid-{{ sid }}">
      {%- for block in section.blocks -%}
        <div class="na-team-card-{{ sid }}" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{- block.settings.image | image_url: width: 600 | image_tag:
              class: photo_class,
              alt: block.settings.name,
              loading: 'lazy',
              widths: '200, 400, 600'
            -}}
          {%- elsif block.settings.image_url_fallback != blank -%}
            <img
              class="na-team-photo-{{ sid }}"
              src="{{ block.settings.image_url_fallback }}"
              alt="{{ block.settings.name | escape }}"
              width="400"
              height="520"
              loading="lazy"
            >
          {%- else -%}
            <div class="na-team-photo-{{ sid }}" style="background: #253020;"></div>
          {%- endif -%}
          <div class="na-team-info-{{ sid }}">
            {%- if block.settings.name != blank -%}
              <h3 class="na-team-name-{{ sid }}">{{ block.settings.name }}</h3>
            {%- endif -%}
            {%- if block.settings.role != blank -%}
              <p class="na-team-role-{{ sid }}">{{ block.settings.role }}</p>
            {%- endif -%}
            {%- if block.settings.bio != blank -%}
              <div class="na-team-bio-{{ sid }}">{{ block.settings.bio }}</div>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "NA Team",
  "settings": [
    {
      "type": "select",
      "id": "bg_style",
      "label": "Baggrund",
      "options": [
        { "value": "dark", "label": "Mørk (#2a2a2a)" },
        { "value": "darker", "label": "Dybest (#131c15)" }
      ],
      "default": "dark"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Folkene bag"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Overskrift",
      "info": "Brug kursiv (italic) for at gøre teksten grøn.",
      "default": "<p>Menneskerne bag <em>brandet</em></p>"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Undertekst",
      "default": "Vi har nøje udvalgt et sortiment af produkter fra førende mærker og producenter, der deler vores vision om kvalitet og ydeevne — sæson efter sæson."
    }
  ],
  "blocks": [
    {
      "type": "person",
      "name": "Person",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Foto"
        },
        {
          "type": "text",
          "id": "image_url_fallback",
          "label": "Fallback billed-URL (bruges kun hvis intet foto er valgt)"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Navn"
        },
        {
          "type": "text",
          "id": "role",
          "label": "Rolle"
        },
        {
          "type": "richtext",
          "id": "bio",
          "label": "Bio",
          "info": "Brug kursiv (italic) til citater — de fremhæves."
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "NA Team",
      "blocks": [
        { "type": "person" },
        { "type": "person" }
      ]
    }
  ]
}
{% endschema %}
