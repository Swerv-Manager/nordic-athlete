{%- liquid
  # Produkt-metafelter (custom.pdp_size_*) har forrang over sektionens blokke —
  # én skabelon kan dermed dække alle produkter. Sektionen skjules helt, når
  # hverken metafelt eller blokke findes (fx tilbehør uden størrelser).
  # Kolonne-format: "Størrelse|Interval", fx "M|170–178 cm" (list.single_line_text_field).
  assign mf_cols = product.metafields.custom.pdp_size_columns.value
  assign col_count = 0
  if mf_cols
    assign col_count = mf_cols.size
  endif
  if col_count == 0
    assign col_count = section.blocks.size
    assign mf_cols = blank
  endif

  assign guide_note = product.metafields.custom.pdp_size_note.value | default: section.settings.note

  # Størrelsesguide-billede: indstilling → ellers produktmedie med 'size' i filnavnet → ellers sidste produktbillede
  assign guide_image = section.settings.image
  if guide_image == blank
    for m in product.media
      assign src_down = m.preview_image.src | downcase
      if src_down contains 'size' or src_down contains 'chart' or src_down contains 'guide'
        assign guide_image = m.preview_image
        break
      endif
    endfor
  endif
-%}

{%- if col_count > 0 -%}
<section class="na-sizeguide" id="guide">
  <div class="na-sizeguide__col">
    <span class="na-sizeguide__eyebrow">{{ section.settings.eyebrow }}</span>
    <h2 class="na-sizeguide__heading">{{ section.settings.heading }}</h2>
    <div class="na-sizeguide__table" style="grid-template-columns: repeat({{ col_count }}, 1fr);">
      {%- if mf_cols != blank -%}
        {%- for col in mf_cols -%}
          {%- assign cp = col | split: '|' -%}
          <div class="na-sizeguide__cell na-sizeguide__cell--head{% unless forloop.last %} na-sizeguide__cell--divide{% endunless %}">
            {{- cp[0] | strip -}}
          </div>
        {%- endfor -%}
        {%- for col in mf_cols -%}
          {%- assign cp = col | split: '|' -%}
          <div class="na-sizeguide__cell na-sizeguide__cell--body{% unless forloop.last %} na-sizeguide__cell--divide{% endunless %}">
            {{- cp[1] | strip -}}
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- for block in section.blocks -%}
          <div class="na-sizeguide__cell na-sizeguide__cell--head{% unless forloop.last %} na-sizeguide__cell--divide{% endunless %}" {{ block.shopify_attributes }}>
            {{- block.settings.size -}}
          </div>
        {%- endfor -%}
        {%- for block in section.blocks -%}
          <div class="na-sizeguide__cell na-sizeguide__cell--body{% unless forloop.last %} na-sizeguide__cell--divide{% endunless %}">
            {{- block.settings.range -}}
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
    {%- if guide_note != blank -%}
      <p class="na-sizeguide__note">💡 {{ guide_note }}</p>
    {%- endif -%}
    <div class="na-sizeguide__badges">
      <span class="na-sizeguide__badge">✓ Gratis ombytning</span>
      <span class="na-sizeguide__badge">✓ 30 dages retur</span>
    </div>
  </div>
  {%- if guide_image -%}
    <div class="na-sizeguide__imagewrap">
      {{ guide_image | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'na-sizeguide__img', alt: 'Størrelsesguide' }}
    </div>
  {%- endif -%}
</section>

<style>
  .na-sizeguide {
    max-width: 1280px;
    margin: 0 auto;
    width: 100%;
    padding: 64px 32px;
    box-sizing: border-box;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: start;
  }
  .na-sizeguide__col { display: flex; flex-direction: column; gap: 16px; }
  .na-sizeguide__eyebrow {
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #69E281;
  }
  .na-sizeguide__heading {
    margin: 0;
    font-size: 24px;
    font-weight: 900;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: #ffffff;
  }
  .na-sizeguide__table {
    display: grid;
    border: 1.5px solid #3a3a3a;
    border-radius: 6px;
    overflow: hidden;
    text-align: center;
  }
  .na-sizeguide__cell--head {
    padding: 10px 0;
    background: #131c15;
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0.05em;
    color: #ffffff;
  }
  .na-sizeguide__cell--body {
    padding: 10px 4px;
    font-size: 11px;
    color: #a8b8ae;
    border-top: 1.5px solid #3a3a3a;
  }
  .na-sizeguide__cell--divide { border-right: 1.5px solid #3a3a3a; }
  .na-sizeguide__note { margin: 0; font-size: 13px; line-height: 1.75; color: #a8b8ae; }
  .na-sizeguide__note strong { color: #ffffff; }
  .na-sizeguide__badges { display: flex; gap: 10px; flex-wrap: wrap; }
  .na-sizeguide__badge {
    display: inline-flex;
    align-items: center;
    height: 22px;
    padding: 0 8px;
    border-radius: 4px;
    border: 1.5px solid #3a3a3a;
    color: #a8b8ae;
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .na-sizeguide__imagewrap {
    border-radius: 8px;
    overflow: hidden;
    border: 1.5px solid #3a3a3a;
    background: #131c15;
  }
  .na-sizeguide__img { width: 100%; display: block; }

  @media (max-width: 749px) {
    .na-sizeguide { grid-template-columns: 1fr; padding: 40px 20px; gap: 28px; }
  }
</style>
{%- endif -%}

{% schema %}
{
  "name": "NA PDP Størrelsesguide",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Find din størrelse"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Overskrift",
      "default": "Vælg din normale spillestørrelse"
    },
    {
      "type": "textarea",
      "id": "note",
      "label": "Note under tabellen",
      "default": "Tights sidder tæt med kompression. 9 ud af 10 spillere passer deres normale størrelse — er du i tvivl mellem to størrelser, så vælg den større. Sidder den forkert, bytter vi gratis."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Størrelsesskema-billede",
      "info": "Tom = produktmedie med 'size'/'chart' i filnavnet"
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Størrelseskolonne",
      "settings": [
        { "type": "text", "id": "size", "label": "Størrelse", "default": "M" },
        { "type": "text", "id": "range", "label": "Interval", "default": "170–178 cm" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "NA PDP Størrelsesguide",
      "category": "Product",
      "blocks": [
        { "type": "column", "settings": { "size": "S", "range": "165–172 cm" } },
        { "type": "column", "settings": { "size": "M", "range": "170–178 cm" } },
        { "type": "column", "settings": { "size": "L", "range": "176–186 cm" } },
        { "type": "column", "settings": { "size": "XL", "range": "184–194 cm" } },
        { "type": "column", "settings": { "size": "2XL", "range": "192–202 cm" } }
      ]
    }
  ]
}
{% endschema %}
