{%- liquid
  # Produkt-metafelter (custom.pdp_size_*) har forrang over sektionens blokke —
  # én skabelon kan dermed dække alle produkter. Sektionen skjules helt, når
  # hverken metafelt eller blokke findes (fx tilbehør uden størrelser).
  # Række-format (list.single_line_text_field): hvert element er én tabelrække
  # med |-adskilte celler; FØRSTE element er header-rækken.
  # Fx: "Mål|XS|S|M|L" · "CM|24–26|26–28|28–30|30–32"
  assign mf_rows = product.metafields.custom.pdp_size_columns.value
  assign row_count = 0
  if mf_rows
    assign row_count = mf_rows.size
  endif
  if row_count == 0
    assign mf_rows = blank
  endif
  assign col_count = row_count
  if col_count == 0
    assign col_count = section.blocks.size
  endif

  assign guide_heading = product.metafields.custom.pdp_size_heading.value | default: section.settings.heading
  assign guide_note = product.metafields.custom.pdp_size_note.value | default: section.settings.note

  # Måleinstruktion (how-box): "Emoji|Label|Tekst", fx "💪|Albueomkreds|Mål rundt om albuen …"
  assign guide_measure = product.metafields.custom.pdp_size_measure.value

  # Størrelsesguide-billede: indstilling → ellers produktmedie med 'size' i filnavnet → ellers sidste produktbillede
  assign guide_image = section.settings.image
  if guide_image == blank
    for m in product.media
      assign src_down = m.preview_image.src | downcase
      if src_down contains 'size' or src_down contains 'chart' or src_down contains 'guide'
        assign guide_image = m.preview_image
        break
      endif
    endfor
  endif
-%}

{%- if col_count > 0 -%}
<section class="na-sizeguide{% unless guide_image %} na-sizeguide--noimage{% endunless %}" id="guide">
  <div class="na-sizeguide__col">
    <span class="na-sizeguide__eyebrow">{{ section.settings.eyebrow }}</span>
    <h2 class="na-sizeguide__heading">{{ guide_heading }}</h2>
    {%- if guide_measure != blank -%}
      {%- assign gm = guide_measure | split: '|' -%}
      <div class="na-sizeguide__how">
        <span class="na-sizeguide__how-icon">{{ gm[0] | strip }}</span>
        <div class="na-sizeguide__how-text">
          <strong>{{ gm[1] | strip }}</strong>
          <p>{{ gm[2] | strip }}</p>
        </div>
      </div>
    {%- endif -%}
    <div class="na-sizeguide__scroll">
      <table class="na-sizeguide__table">
        {%- if mf_rows != blank -%}
          {%- assign header_cells = mf_rows | first | split: '|' -%}
          <thead>
            <tr>{% for c in header_cells %}<th>{{ c | strip }}</th>{% endfor %}</tr>
          </thead>
          <tbody>
            {%- for row in mf_rows offset: 1 -%}
              {%- assign cells = row | split: '|' -%}
              <tr>{% for c in cells %}{% if forloop.first %}<td class="na-sizeguide__rowlbl">{{ c | strip }}</td>{% else %}<td>{{ c | strip }}</td>{% endif %}{% endfor %}</tr>
            {%- endfor -%}
          </tbody>
        {%- else -%}
          <thead>
            <tr>{% for block in section.blocks %}<th {{ block.shopify_attributes }}>{{ block.settings.size }}</th>{% endfor %}</tr>
          </thead>
          <tbody>
            <tr>{% for block in section.blocks %}<td>{{ block.settings.range }}</td>{% endfor %}</tr>
          </tbody>
        {%- endif -%}
      </table>
    </div>
    {%- if guide_note != blank -%}
      <p class="na-sizeguide__note">💡 {{ guide_note | newline_to_br }}</p>
    {%- endif -%}
    <div class="na-sizeguide__badges">
      <span class="na-sizeguide__badge">✓ Gratis ombytning</span>
      <span class="na-sizeguide__badge">✓ 30 dages retur</span>
    </div>
  </div>
  {%- if guide_image -%}
    <div class="na-sizeguide__imagewrap">
      {{ guide_image | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'na-sizeguide__img', alt: 'Størrelsesguide' }}
    </div>
  {%- endif -%}
</section>

<style>
  .na-sizeguide {
    max-width: 1280px;
    margin: 0 auto;
    width: 100%;
    padding: 64px 32px;
    box-sizing: border-box;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: start;
  }
  .na-sizeguide--noimage { grid-template-columns: 1fr; max-width: 900px; }
  .na-sizeguide__col { display: flex; flex-direction: column; gap: 16px; }
  .na-sizeguide__eyebrow {
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #69E281;
  }
  .na-sizeguide__heading {
    margin: 0;
    font-size: 24px;
    font-weight: 900;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: #ffffff;
  }
  .na-sizeguide__how {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    background: #253020;
    border: 1.5px solid #3a3a3a;
    border-radius: 8px;
    padding: 12px 14px;
  }
  .na-sizeguide__how-icon { font-size: 30px; line-height: 1; flex: none; }
  .na-sizeguide__how-text strong {
    display: block;
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #ffffff;
    margin-bottom: 3px;
  }
  .na-sizeguide__how-text p { margin: 0; font-size: 12px; color: #a8b8ae; }
  .na-sizeguide__scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .na-sizeguide__table {
    border-collapse: separate;
    border-spacing: 0;
    width: 100%;
    border: 1.5px solid #3a3a3a;
    border-radius: 6px;
    overflow: hidden;
    text-align: center;
  }
  .na-sizeguide__table th {
    padding: 10px 6px;
    background: #131c15;
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0.05em;
    color: #ffffff;
    white-space: nowrap;
  }
  .na-sizeguide__table td {
    padding: 10px 6px;
    font-size: 11px;
    color: #a8b8ae;
    border-top: 1.5px solid #3a3a3a;
    white-space: nowrap;
  }
  .na-sizeguide__table th + th,
  .na-sizeguide__table td + td { border-left: 1.5px solid #3a3a3a; }
  .na-sizeguide__rowlbl { font-weight: 900; color: #ffffff; background: #131c15; }
  .na-sizeguide__note { margin: 0; font-size: 13px; line-height: 1.75; color: #a8b8ae; }
  .na-sizeguide__note strong { color: #ffffff; }
  .na-sizeguide__badges { display: flex; gap: 10px; flex-wrap: wrap; }
  .na-sizeguide__badge {
    display: inline-flex;
    align-items: center;
    height: 22px;
    padding: 0 8px;
    border-radius: 4px;
    border: 1.5px solid #3a3a3a;
    color: #a8b8ae;
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .na-sizeguide__imagewrap {
    border-radius: 8px;
    overflow: hidden;
    border: 1.5px solid #3a3a3a;
    background: #131c15;
  }
  .na-sizeguide__img { width: 100%; display: block; }

  @media (max-width: 749px) {
    .na-sizeguide { grid-template-columns: 1fr; padding: 40px 20px; gap: 28px; }
  }
</style>
{%- endif -%}

{% schema %}
{
  "name": "NA PDP Størrelsesguide",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Find din størrelse"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Overskrift",
      "default": "Vælg din normale spillestørrelse"
    },
    {
      "type": "textarea",
      "id": "note",
      "label": "Note under tabellen",
      "default": "Tights sidder tæt med kompression. 9 ud af 10 spillere passer deres normale størrelse — er du i tvivl mellem to størrelser, så vælg den større. Sidder den forkert, bytter vi gratis."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Størrelsesskema-billede",
      "info": "Tom = produktmedie med 'size'/'chart' i filnavnet"
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Størrelseskolonne",
      "settings": [
        { "type": "text", "id": "size", "label": "Størrelse", "default": "M" },
        { "type": "text", "id": "range", "label": "Interval", "default": "170–178 cm" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "NA PDP Størrelsesguide",
      "category": "Product",
      "blocks": [
        { "type": "column", "settings": { "size": "S", "range": "165–172 cm" } },
        { "type": "column", "settings": { "size": "M", "range": "170–178 cm" } },
        { "type": "column", "settings": { "size": "L", "range": "176–186 cm" } },
        { "type": "column", "settings": { "size": "XL", "range": "184–194 cm" } },
        { "type": "column", "settings": { "size": "2XL", "range": "192–202 cm" } }
      ]
    }
  ]
}
{% endschema %}
