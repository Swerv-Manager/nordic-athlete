{% schema %}
{
  "name": "NA GAMEPATCH Skin",
  "settings": [
    {
      "type": "paragraph",
      "content": "Usynlig sektion: leverer NA dark-mode styling (kort, grid, badges) og quick-add JS til GAMEPATCH-kollektionsskabelonen. Skal ligge i skabelonen sammen med hovedkollektionssektionen."
    }
  ],
  "presets": [
    {
      "name": "NA GAMEPATCH Skin",
      "category": "Collection"
    }
  ]
}
{% endschema %}

<style>
  /* ─── NA GAMEPATCH SKIN — template-scoped (kun sider med denne sektion) ─── */

  body { background-color: #2a2a2a; }

  /* ── Produktkort ── */
  .product-card { position: relative; }

  .product-card .product-card__content {
    background: #253020;
    border: 1.5px solid #3a3a3a !important;
    border-radius: 8px;
    overflow: hidden;
    transition: border-color 140ms;
    color: #ffffff;
  }
  .product-card:hover .product-card__content,
  .product-card:focus-within .product-card__content {
    border-color: #3d7a52 !important;
  }

  .product-card__content a { color: #ffffff; }

  .product-card__content :is(h2, h3, h4, h5, .h5, .h6) {
    text-transform: uppercase;
    letter-spacing: 0.03em;
    line-height: 1.35;
  }

  /* Skjul Horizons indbyggede quick-add — vi bruger NA-overlayet */
  .product-card [class*="quick-add"] { display: none !important; }

  /* ── Brand-eyebrow + renset titel (Alfalab-mønster) ── */
  .na-cardx-brand {
    display: block;
    padding: 12px 10px 0;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #76837b;
  }
  .na-cardx-title {
    margin: 0;
    padding: 3px 10px 0;
    font-size: 13.5px;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: #ffffff;
    line-height: 1.35;
  }

  /* ── Kropszone-linje ── */
  .na-cardx-zone {
    display: block;
    font-size: 12px;
    color: #a8b8ae;
    padding-inline-start: 10px;
    padding-inline-end: 10px;
    padding-block-start: 2px;
  }

  /* ── Media-proxy: kvadrat oven på galleriet (billedet er 1:1 øverst i kortet) ── */
  .na-cardx-media {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    aspect-ratio: 1 / 1;
    pointer-events: none;
    z-index: 3;
  }

  /* ── Badge ── */
  .na-cardx-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    padding: 4px 8px;
    border-radius: 4px;
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    line-height: 1.2;
  }
  .na-cardx-badge--green {
    background: #3d7a52;
    color: #131c15;
    border: 1.5px solid #3d7a52;
  }
  .na-cardx-badge--stock {
    background: rgba(19, 28, 21, 0.9);
    color: #d8a657;
    border: 1.5px solid #d8a657;
  }

  /* ── Pris — ens visning uanset om produktet er nedsat eller ej ──
     Horizon udsender BÅDE .price__regular og .price__sale og skjuler den
     inaktive med .price__hidden (respekteres nedenfor). Udsalgsprisen bærer
     både .price OG .price-item--sale; vi tvinger alle aktuelle priser til
     17px med høj specificitet + !important, så nedsat og ikke-nedsat matcher. */
  .product-card .price__hidden {
    display: none !important;
  }
  .product-card .price__regular,
  .product-card .price__sale {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px;
  }
  .product-card .price,
  .product-card .price-item--sale,
  .product-card .price-item--regular {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }
  .product-card .price__regular .price,
  .product-card .price__sale .price-item--sale,
  .product-card .price__sale .price.price-item--sale {
    font-size: 17px !important;
    font-weight: 900 !important;
    color: #ffffff !important;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }
  .product-card .price__sale .price-item--regular,
  .product-card .price__sale .compare-at-price {
    font-size: 12px !important;
    font-weight: 600 !important;
    color: #76837b !important;
    text-decoration: line-through;
    letter-spacing: 0;
    line-height: 1.2;
  }

  /* ── Quick-add overlay ── */
  .na-cardx-qa {
    position: absolute;
    left: 10px;
    right: 10px;
    bottom: 10px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 12px;
    background: rgba(19, 28, 21, 0.94);
    border: 1.5px solid #3a3a3a;
    border-radius: 6px;
    opacity: 0;
    transform: translateY(8px);
    pointer-events: none;
    transition: opacity 220ms cubic-bezier(0.16, 1, 0.3, 1), transform 220ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .product-card:hover .na-cardx-qa,
  .product-card:focus-within .na-cardx-qa,
  .na-cardx-qa.is-added {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .na-cardx-qa__hint {
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #a8b8ae;
  }
  .na-cardx-qa.is-added .na-cardx-qa__hint { color: #69E281; }

  .na-cardx-qa__sizes {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .na-qa-btn {
    flex: 1;
    min-width: 34px;
    height: 34px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    cursor: pointer;
    font-family: inherit;
    font-weight: 900;
    font-size: 11px;
    background: transparent;
    color: #ffffff;
    border: 1.5px solid #3a3a3a;
    transition: all 140ms;
    text-decoration: none;
    padding: 0 8px;
  }
  .na-qa-btn:hover:not(:disabled),
  .na-qa-btn:focus-visible {
    border-color: #3d7a52;
  }
  .na-qa-btn.is-active {
    background: #3d7a52;
    color: #131c15;
    border-color: #3d7a52;
  }
  .na-qa-btn:disabled {
    opacity: 0.35;
    cursor: not-allowed;
    text-decoration: line-through;
  }
  .na-qa-btn.is-loading { opacity: 0.6; pointer-events: none; }
  .na-qa-btn--wide { flex: 1 1 100%; }

  /* Touch-enheder: intet hover — vis overlay permanent i kompakt form */
  @media (hover: none) {
    .na-cardx-qa {
      opacity: 1;
      transform: none;
      pointer-events: auto;
      padding: 8px;
      gap: 6px;
    }
    .na-cardx-qa__hint { display: none; }
    .na-cardx-qa.is-added .na-cardx-qa__hint { display: block; }
    .na-qa-btn { height: 30px; font-size: 10px; }
  }
</style>

<script>
  (function () {
    if (window.__naQaBound) return;
    window.__naQaBound = true;

    /* Brug temaets egne cart-ruter når de findes */
    function cartAddUrl() {
      try {
        if (window.Theme && Theme.routes && Theme.routes.cart_add_url) return Theme.routes.cart_add_url;
      } catch (e) {}
      return '/cart/add.js';
    }

    /* Saml sektions-id'er for alle cart-items-component (samme mønster som product-form.js),
       så vi kan bede serveren rendere den opdaterede kurv-skuffe med i svaret. */
    function cartSectionIds() {
      var ids = [];
      document.querySelectorAll('cart-items-component[data-section-id]').forEach(function (el) {
        var id = el.getAttribute('data-section-id');
        if (id && ids.indexOf(id) === -1) ids.push(id);
      });
      return ids;
    }

    document.addEventListener(
      'click',
      function (e) {
        var btn = e.target.closest('.na-qa-btn[data-variant-id]');
        if (!btn) return;
        e.preventDefault();
        e.stopPropagation();
        if (btn.disabled || btn.classList.contains('is-loading')) return;

        var qa = btn.closest('[data-na-qa]');
        btn.classList.add('is-loading');

        var ids = cartSectionIds();
        var form = new FormData();
        form.append('id', btn.getAttribute('data-variant-id'));
        form.append('quantity', '1');
        if (ids.length) {
          form.append('sections', ids.join(','));
          form.append('sections_url', window.location.pathname);
        }

        fetch(cartAddUrl(), {
          method: 'POST',
          headers: { Accept: 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
          body: form
        })
          .then(function (r) {
            if (!r.ok) return r.json().then(function (err) { throw err; });
            return r.json();
          })
          .then(function (added) {
            return fetch('/cart.js', { headers: { Accept: 'application/json' } })
              .then(function (r) { return r.json(); })
              .then(function (cart) {
                /* Dispatch temaets egen cart:update-event, så cart-icon (antal),
                   cart-items-component (skuffe-indhold) og cart-drawer reagerer.
                   source !== 'product-form-component' => cart-icon SÆTTER antallet
                   til cart.item_count (fuld total), ikke additivt. */
                document.dispatchEvent(new CustomEvent('cart:update', {
                  bubbles: true,
                  detail: {
                    resource: cart,
                    sourceId: 'na-quick-add',
                    data: {
                      source: 'na-quick-add',
                      itemCount: cart.item_count,
                      variantId: btn.getAttribute('data-variant-id'),
                      sections: added.sections
                    }
                  }
                }));

                if (qa) {
                  qa.classList.add('is-added');
                  qa.querySelectorAll('.na-qa-btn').forEach(function (b) { b.classList.remove('is-active'); });
                  btn.classList.add('is-active');
                  var hint = qa.querySelector('[data-na-qa-hint]');
                  if (hint) {
                    hint.textContent = '\u2713 Tilf\u00f8jet til kurv' + (btn.dataset.naSize ? ' \u2014 str. ' + btn.dataset.naSize : '');
                    hint.style.display = 'block';
                  }
                }
              });
          })
          .catch(function (err) {
            if (qa) {
              var hint = qa.querySelector('[data-na-qa-hint]');
              if (hint) {
                hint.textContent = (err && (err.description || err.message)) ? (err.description || err.message) : 'Kunne ikke tilf\u00f8je \u2014 pr\u00f8v igen';
                hint.style.display = 'block';
              }
            }
          })
          .finally(function () {
            btn.classList.remove('is-loading');
          });
      },
      true
    );
  })();
</script>
