{%- comment -%}
  NA Collection SEO-tekst — udvidet kategoritekst under produktgridden.
  Indhold: kollektions-metafeltet custom.seo_text (rich_text_field).
  Sektionen skjules helt, når metafeltet er tomt — ingen kode pr. kollektion.
{%- endcomment -%}

{%- if collection.metafields.custom.seo_text.value != blank -%}
<section class="na-cseo">
  <div class="na-cseo__inner">
    {{ collection.metafields.custom.seo_text | metafield_tag }}
  </div>
</section>

<style>
  .na-cseo {
    background: #2a2a2a;
    border-top: 1.5px solid #3a3a3a;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  .na-cseo__inner {
    max-width: 900px;
    margin: 0 auto;
    padding: 56px 32px;
    box-sizing: border-box;
    font-size: 14px;
    line-height: 1.8;
    color: #a8b8ae;
  }
  .na-cseo__inner h2,
  .na-cseo__inner h3,
  .na-cseo__inner h4 {
    margin: 26px 0 10px;
    font-weight: 900;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: #ffffff;
  }
  .na-cseo__inner h2:first-child,
  .na-cseo__inner h3:first-child { margin-top: 0; }
  .na-cseo__inner h2 { font-size: 20px; }
  .na-cseo__inner h3 { font-size: 15px; }
  .na-cseo__inner p { margin: 0 0 12px; }
  .na-cseo__inner a { color: #69E281; }
  .na-cseo__inner strong { color: #ffffff; }
  .na-cseo__inner ul { margin: 10px 0; padding-left: 20px; }

  @media (max-width: 749px) {
    .na-cseo__inner { padding: 40px 20px; }
  }
</style>
{%- endif -%}

{% schema %}
{
  "name": "NA Collection SEO-tekst",
  "settings": [
    {
      "type": "paragraph",
      "content": "Viser kollektions-metafeltet custom.seo_text (rich text) under produktgridden. Tomt metafelt = sektionen skjules."
    }
  ],
  "presets": [
    {
      "name": "NA Collection SEO-tekst",
      "category": "Collection"
    }
  ]
}
{% endschema %}
