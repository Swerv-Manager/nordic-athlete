{%- doc -%}
  NA PDP-ekstras — små købsboks-elementer, renderet fra custom-liquid blokke
  i product-information-sektionen. Styles ligger i sections/na-pdp-skin.liquid.

  @param {string} part - Hvilket element: 'breadcrumb' | 'badges' | 'eyebrow' |
    'rating' | 'freeshipping' | 'sizeheader' | 'fit' | 'delivery' | 'payment' | 'desc'
  @param {object} product - Produktet (send closest.product med fra blokken)
  @param {string} [text] - Fritekst (eyebrow, fit, desc)
  @param {string} [cutoff] - Leveringsdeadline, fx '14.00' (part: delivery)
  @param {string} [rating] - fx '4,9/5' (part: rating)
  @param {string} [count] - fx '1.200+ anmeldelser' (part: rating)
{%- enddoc -%}

{%- case part -%}
  {%- when 'breadcrumb' -%}
    {%- assign crumb_collection = product.collections | where: 'handle', 'gamepatch-1' | first | default: product.collections.first -%}
    <nav class="na-pdpx-breadcrumb" aria-label="Brødkrumme">
      {%- if crumb_collection -%}
        <a href="{{ crumb_collection.url }}">{{ crumb_collection.title }}</a> / {{ product.title }}
      {%- else -%}
        <a href="{{ routes.all_products_collection_url }}">Alle produkter</a> / {{ product.title }}
      {%- endif -%}
    </nav>

  {%- when 'badges' -%}
    {%- liquid
      assign v = product.selected_or_first_available_variant
      assign qty = v.inventory_quantity | default: 0
      assign show_stock = false
      if v.inventory_management != blank and qty > 0 and qty <= 10
        assign show_stock = true
      endif
    -%}
    {%- liquid
      # Badge: metafelt -> "Officiel partner" (kun Gamepatch) -> vendor -> ingen
      assign badge_label = product.metafields.custom.pdp_badge.value
      if badge_label == blank
        assign vendor_down = product.vendor | downcase
        assign title_down = product.title | downcase
        if vendor_down contains 'gamepatch' or title_down contains 'gamepatch'
          assign badge_label = 'Officiel partner'
        elsif vendor_down != blank and vendor_down != 'nordic-athlete' and vendor_down != 'nordic athlete'
          assign badge_label = product.vendor
        endif
      endif
    -%}
    <div class="na-pdpx-badges" data-na-stock-badges>
      {%- if badge_label != blank -%}
        <span class="na-pdpx-badge na-pdpx-badge--green">{{ badge_label }}</span>
      {%- endif -%}
      <span
        class="na-pdpx-badge na-pdpx-badge--stock"
        data-na-stock-badge
        {% unless show_stock %}hidden{% endunless %}
      >
        {%- if show_stock %}Kun {{ qty }} tilbage på lager{% endif -%}
      </span>
    </div>
    <script type="application/json" data-na-stock-data>
      {
        {%- for variant in product.variants -%}
          "{{ variant.id }}": {{ variant.inventory_quantity | default: 0 }}{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      }
    </script>
    <script>
      (function () {
        if (window.__naStockBadgeBound) return;
        window.__naStockBadgeBound = true;
        /* Horizon morpher kun variant-pickeren ved variantskift, ikke hele
           product-details — derfor opdaterer vi badgen via variant:update. */
        document.addEventListener('variant:update', function (e) {
          var variant = e.detail && e.detail.resource;
          if (!variant || !variant.id) return;
          document.querySelectorAll('[data-na-stock-badges]').forEach(function (wrap) {
            var dataEl = wrap.parentElement.querySelector('[data-na-stock-data]') || document.querySelector('[data-na-stock-data]');
            var badge = wrap.querySelector('[data-na-stock-badge]');
            if (!dataEl || !badge) return;
            var map;
            try { map = JSON.parse(dataEl.textContent); } catch (err) { return; }
            var qty = map[String(variant.id)];
            if (typeof qty === 'number' && qty > 0 && qty <= 10) {
              badge.textContent = 'Kun ' + qty + ' tilbage på lager';
              badge.hidden = false;
            } else {
              badge.hidden = true;
            }
          });
        });
      })();
    </script>

  {%- when 'eyebrow' -%}
    <span class="na-pdpx-eyebrow">{{ product.metafields.custom.pdp_eyebrow.value | default: text | default: 'Pas på din krop — den skal holde i mange år' }}</span>

  {%- when 'rating' -%}
    <a class="na-pdpx-rating" href="#anmeldelser">★★★★★ <span class="na-pdpx-rating__score">{{ rating | default: '4,9/5' }}</span> · {{ count | default: '1.200+ anmeldelser' }} →</a>

  {%- when 'freeshipping' -%}
    {%- if product.price >= 60000 -%}
      <span class="na-pdpx-freeshipping">✓ Fri fragt</span>
    {%- else -%}
      <span class="na-pdpx-freeshipping" style="color: #a8b8ae;">Fri fragt over 600 kr</span>
    {%- endif -%}

  {%- when 'sizeheader' -%}
    <div class="na-pdpx-sizeheader">
      <span class="na-pdpx-sizeheader__label">Størrelse</span>
      {%- comment -%} Guide-linket vises kun, når produktet faktisk har en størrelsesguide (ellers er #guide et dødt anker). {%- endcomment -%}
      {%- if product.metafields.custom.pdp_size_columns.value.size > 0 -%}
        <a class="na-pdpx-sizeheader__link" href="#guide">Størrelsesguide</a>
      {%- endif -%}
    </div>

  {%- when 'fit' -%}
    {%- assign fit_text = product.metafields.custom.pdp_fit_note.value | default: text -%}
    {%- if fit_text != blank -%}
      <p class="na-pdpx-fit">{{ fit_text }}</p>
    {%- endif -%}

  {%- when 'delivery' -%}
    <div class="na-pdpx-delivery">
      <span class="na-pdpx-delivery__line1">🚚 Bestil inden <strong>kl. {{ cutoff | default: '14.00' }}</strong> — hos dig i morgen</span>
      <span class="na-pdpx-delivery__line2">GLS dag-til-dag (1–2 hverdage) · 30 dages retur på ubrugte varer</span>
    </div>

  {%- when 'payment' -%}
    <div class="na-pdpx-payment">
      <span>MobilePay</span><span>·</span><span>Visa</span><span>·</span><span>Mastercard</span><span>·</span><span>Apple Pay</span>
    </div>

  {%- when 'desc' -%}
    {%- liquid
      assign desc_preview = product.metafields.custom.pdp_short_desc.value | default: text
      assign desc_full_plain = product.description | strip_html | strip
      if desc_preview == blank
        assign desc_preview = desc_full_plain | truncate: 220
      endif
    -%}
    {%- if desc_full_plain.size > 240 -%}
      <details class="na-pdpx-descwrap">
        <summary class="na-pdpx-desc">
          <span class="na-pdpx-desc__preview">{{ desc_preview }}</span>
          <span class="na-pdpx-desc__more">Læs hele beskrivelsen ▾</span>
          <span class="na-pdpx-desc__less">Vis mindre ▴</span>
        </summary>
        <div class="na-pdpx-desc na-pdpx-desc--full">{{ product.description }}</div>
      </details>
    {%- elsif desc_preview != blank -%}
      <p class="na-pdpx-desc">{{ desc_preview }}</p>
    {%- endif -%}
{%- endcase -%}
