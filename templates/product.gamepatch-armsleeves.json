                "custom_liquid": "<!-- ═══════════════════════════════════════════════════════════════\n     NA PRODUCT BLOCK: Trust Badges\n     Brug: Custom Liquid block i product-info sektionen\n     Placering: EFTER buy-buttons-blokken\n     ═══════════════════════════════════════════════════════════════ -->\n\n<style>\n  .na-pb-trust {\n    display: flex;\n    gap: 0;\n    border: 1px solid #2e3d32;\n    border-radius: 10px;\n    overflow: hidden;\n    margin-top: 4px;\n  }\n  .na-pb-trust-item {\n    flex: 1;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    gap: 4px;\n    padding: 12px 8px;\n    background-color: #00000;\n    text-align: center;\n  }\n  .na-pb-trust-item + .na-pb-trust-item {\n    border-left: 1px solid #2e3d32;\n  }\n  .na-pb-trust-icon {\n    font-size: 18px;\n    line-height: 1;\n  }\n  .na-pb-trust-title {\n    font-size: 11.5px;\n    font-weight: 700;\n    color: #ffffff;\n    line-height: 1.2;\n  }\n  .na-pb-trust-sub {\n    font-size: 10px;\n    color: #68706c;\n    line-height: 1.2;\n  }\n</style>\n\n<div class=\"na-pb-trust\">\n  <div class=\"na-pb-trust-item\">\n    <span class=\"na-pb-trust-icon\">🚚</span>\n    <span class=\"na-pb-trust-title\">Dag til dag</span>\n    <span class=\"na-pb-trust-sub\">levering på lagervarer</span>\n  </div>\n  <div class=\"na-pb-trust-item\">\n    <span class=\"na-pb-trust-icon\">↩️</span>\n    <span class=\"na-pb-trust-title\">30 dages</span>\n    <span class=\"na-pb-trust-sub\">returret</span>\n  </div>\n  <div class=\"na-pb-trust-item\">\n    <span class=\"na-pb-trust-icon\">🇪🇺</span>\n    <span class=\"na-pb-trust-title\">Håndlavet</span>\n    <span class=\"na-pb-trust-sub\">i Europa</span>\n  </div>\n  <div class=\"na-pb-trust-item\">\n    <span class=\"na-pb-trust-icon\">🔒</span>\n    <span class=\"na-pb-trust-title\">Sikker</span>\n    <span class=\"na-pb-trust-sub\">betaling</span>\n  </div>\n</div>"
              },
