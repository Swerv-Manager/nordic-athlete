            "custom_liquid_F7gwa8": {
              "type": "custom-liquid",
              "name": "t:names.custom_liquid",
              "settings": {
                "custom_liquid": "<!-- ═══════════════════════════════════════════════════════════════\n     NA PRODUCT BLOCK: Accordion — Gamepatch Arm Sleeves\n     Placering: Custom Liquid block EFTER trust-badges blokken\n     Indeholder: Produktbeskrivelse · Størrelsesguide (albueomkreds) · Levering & Retur\n     ═══════════════════════════════════════════════════════════════ -->\n<style>\n  .na-accordion {\n    display: flex; flex-direction: column; gap: 0; margin-top: 8px;\n  }\n  .na-accordion-item {\n    border: 1px solid #2e3d32; border-radius: 0; overflow: hidden;\n  }\n  .na-accordion-item:first-child { border-radius: 8px 8px 0 0; }\n  .na-accordion-item:last-child  { border-radius: 0 0 8px 8px; }\n  .na-accordion-item + .na-accordion-item { border-top: none; }\n  .na-accordion-item summary {\n    display: flex; align-items: center; justify-content: space-between;\n    gap: 12px; padding: 14px 18px; background-color: #253020;\n    cursor: pointer; list-style: none; font-size: 12px; font-weight: 700;\n    letter-spacing: 0.08em; text-transform: uppercase; color: #ffffff;\n    transition: background-color 0.15s, color 0.15s; user-select: none;\n  }\n  .na-accordion-item summary::-webkit-details-marker { display: none; }\n  .na-accordion-item summary::marker { display: none; }\n  .na-accordion-item summary:hover { background-color: #2c3d2e; color: #3d7a52; }\n  .na-accordion-item[open] > summary { color: #3d7a52; background-color: #2a2a2a; border-bottom: 1px solid #2e3d32; }\n  .na-accordion-chevron {\n    width: 16px; height: 16px; flex-shrink: 0;\n    transition: transform 0.2s ease; color: currentColor;\n  }\n  .na-accordion-item[open] .na-accordion-chevron { transform: rotate(180deg); }\n  .na-accordion-body {\n    background-color: #2a2a2a; padding: 16px 18px;\n    font-size: 14px; color: #a8b8ae; line-height: 1.75;\n  }\n  .na-accordion-body p { margin: 0 0 10px; }\n  .na-accordion-body p:last-child { margin-bottom: 0; }\n  .na-accordion-body ul { margin: 8px 0; padding-left: 0; list-style: none; }\n  .na-accordion-body ul li { padding: 3px 0; display: flex; align-items: flex-start; gap: 8px; }\n  .na-accordion-body strong { color: #ffffff; }\n\n  /* ── Size guide: elbow circumference ── */\n  .na-sg-label {\n    font-size: 10px; font-weight: 800; letter-spacing: 0.14em;\n    text-transform: uppercase; color: #5ab87a; margin: 0 0 10px 0;\n  }\n  .na-sg-how {\n    display: flex; align-items: flex-start; gap: 14px;\n    background: #1a2a1f; border-radius: 8px; padding: 12px 14px; margin-bottom: 16px;\n  }\n  .na-sg-how-icon { font-size: 32px; line-height: 1; flex-shrink: 0; }\n  .na-sg-how-text strong {\n    display: block; font-size: 11px; font-weight: 800;\n    letter-spacing: 0.08em; text-transform: uppercase; color: #ffffff; margin-bottom: 3px;\n  }\n  .na-sg-how-text p { font-size: 12px; color: #a8b8ae; margin: 0; }\n  .na-sg-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }\n  .na-sg-table { border-collapse: collapse; width: 100%; min-width: 320px; }\n  .na-sg-table th, .na-sg-table td {\n    border: 1px solid #2a3828; text-align: center; padding: 8px 10px; font-size: 13px;\n  }\n  .na-sg-table thead th {\n    background: #2d5a3d; color: #ffffff; font-weight: 800;\n    font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase;\n  }\n  .na-sg-table .row-lbl {\n    background: #1a2a1f !important; color: #5ab87a; font-weight: 800;\n    font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase;\n    text-align: left; padding-left: 12px;\n  }\n  .na-sg-table tbody tr:nth-child(odd) td  { background: #131c15; }\n  .na-sg-table tbody tr:nth-child(even) td { background: #1a2a1f; }\n  .na-sg-table tbody tr td:first-child { background: #1a2a1f; }\n  .na-sg-tip {\n    font-size: 11.5px; color: #6a7a70; margin-top: 12px;\n    padding: 10px 14px; background: #1a2a1f;\n    border-left: 3px solid #2d5a3d; border-radius: 0 6px 6px 0;\n  }\n</style>\n\n<div class=\"na-accordion\">\n\n  <!-- 1: