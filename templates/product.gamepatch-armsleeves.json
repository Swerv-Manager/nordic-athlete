            "custom_liquid_XP3KWA": {
              "type": "custom-liquid",
              "name": "t:names.custom_liquid",
              "settings": {
                "custom_liquid": "{% comment %}\n  ══════════════════════════════════════════════\n  LAGER STATUS BAR — Nordic Athlete\n  Indsæt som \"Custom Liquid\" blok i\n  Shopify Customizer → Product page\n\n  Dynamisk logik (JavaScript-drevet):\n  - Lytter på variant:change event fra Shopifys\n    native variant-picker — opdaterer i realtid\n    når kunden skifter størrelse, side eller farve\n  - Viser korrekt lagerantal for den PRÆCISE\n    kombination kunden har valgt\n      0       → Udsolgt: 7–10 dages levering (grå)\n      1–3     → \"Kun X tilbage\" (rød/kritisk)\n      4–8     → \"Populær · Kun Y tilbage\" (gul)\n      9+      → \"På lager · Leveres dag til dag\" (grøn)\n  ══════════════════════════════════════════════\n{% endcomment %}\n\n{%- comment %} Embed all variant data as JSON for JS to read {%- endcomment %}\n<script type=\"application/json\" id=\"na-variant-data\">\n  [\n    {%- for variant in product.variants -%}\n      {\n        \"id\": {{ variant.id }},\n        \"available\": {{ variant.available }},\n        \"inventory_quantity\": {{ variant.inventory_quantity | default: 0 }},\n        \"inventory_management\": {{ variant.inventory_management | json }}\n      }{% unless forloop.last %},{% endunless %}\n    {%- endfor -%}\n  ]\n</script>\n\n{%- comment %} Initial render via Liquid (first selected variant) {%- endcomment %}\n{%- assign variant = product.selected_or_first_available_variant -%}\n{%- assign qty = variant.inventory_quantity | default: 0 -%}\n{%- assign track = variant.inventory_management -%}\n\n<div id=\"na-stock-bar-wrapper\">\n  {%- if track == 'shopify' -%}\n    {%- if qty <= 0 -%}\n      <div class=\"na-stock-bar na-stock--soldout\">\n        <span class=\"na-stock-dot\"></span>\n        <span class=\"na-stock-text\"><strong>Udsolgt:</strong> 7–10 dages levering.</span>\n      </div>\n    {%- elsif qty <= 3 -%}\n      <div class=\"na-stock-bar na-stock--critical\">\n        <span class=\"na-stock-dot\"></span>\n        <span class=\"na-stock-text\"><strong>Kun {{ qty }} tilbage på lager</strong> — bestil nu for at sikre din.</span>\n      </div>\n    {%- elsif qty <= 8 -%}\n      <div class=\"na-stock-bar na-stock--low\">\n        <span class=\"na-stock-dot\"></span>\n        <span class=\"na-stock-text\"><strong>Populær:</strong> Mange kigger på dette nu &nbsp;·&nbsp; <strong>Kun {{ qty }} tilbage på lager</strong></span>\n      </div>\n    {%- else -%}\n      <div class=\"na-stock-bar na-stock--normal\">\n        <span class=\"na-stock-dot\"></span>\n        <span class=\"na-stock-text\"><strong>På lager</strong> — leveres dag til dag med GLS</span>\n      </div>\n    {%- endif -%}\n  {%- endif -%}\n</div>\n\n<style>\n  .na-stock-bar {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    border-radius: 6px;\n    padding: 10px 14px;\n    margin: 0 0 14px;\n    font-size: 13px;\n    font-weight: 500;\n    line-height: 1.45;\n    font-family: -apple-system, BlinkMacSystemFont, 'Inter', 'Segoe UI', sans-serif;\n    transition: opacity 0.2s ease;\n  }\n  .na-stock-dot {\n    width: 9px;\n    height: 9px;\n    border-radius: 50%;\n    flex-shrink: 0;\n    position: relative;\n  }\n  .na-stock-dot::after {\n    content: '';\n    position: absolute;\n    inset: -3px;\n    border-radius: 50%;\n    opacity: 0;\n    animation: na-pulse 2s ease-out infinite;\n  }\n  @keyframes na-pulse {\n    0%   { transform: scale(0.8); opacity: 0.6; }\n    70%  { transform: scale(1.8); opacity: 0; }\n    100% { opacity: 0; }\n  }\n\n  /* På lager — grøn */\n  .na-stock--normal {\n    background: #0f1f13;\n    border: 1.5px solid #2d5a3d;\n    color: #a8d4b4;\n  }\n  .na-stock--normal .na-stock-dot { background: #5ab87a; }\n  .na-stock--normal .na-stock-dot::after { background: #5ab87a; }\n  .na-stock--normal .na-stock-text strong { color: #5ab87a; font-weight: 700; }\n\n  /* Lav beholdning — gul */\n  .na-stock--low {\n    background: #1a1500;\n    border: 1.5px solid #7a5c00;\n    color: #c9a84c;\n  }\n  .na-stock--low .na-stock-dot { background: #f0b429; }\n  .na-stock--low .na-stock-dot::after { background: #f0b429; }\n  .na-stock--low .na-stock-text strong { color: #f0b429; font-weight: 700; }\n\n  /* Kritisk lav — rød */\n  .na-stock--critical {\n    background: #1a0a0a;\n    border: 1.5px solid #7a2020;\n    color: #d49494;\n  }\n  .na-stock--critical .na-stock-dot { background: #e53e3e; }\n  .na-stock--critical .na-stock-dot::after { background: #e53e3e; }\n  .na-stock--critical .na-stock-text strong { color: #e86060; font-weight: 700; }\n\n  /* Udsolgt — grå */\n  .na-stock--soldout {\n    background: #111a13;\n    border: 1.5px solid #2e3d32;\n    color: #6b7d70;\n  }\n  .na-stock--soldout .na-stock-dot { background: #4a5a4f; animation: none; }\n  .na-stock--soldout .na-stock-dot::after { display: none; }\n  .na-stock--soldout .na-stock-text strong { color: #8a9e8f; font-weight: 700; }\n\n  @media (max-width: 749px) {\n    .na-stock-bar { font-size: 12px; padding: 9px 12px; }\n  }\n</style>\n\n<script>\n(function () {\n  // ── Build variant lookup map from embedded JSON ──\n  var variantData = JSON.parse(\n    document.getElementById('na-variant-data').textContent\n  );\n  var variantMap = {};\n  variantData.forEach(function (v) { variantMap[v.id] = v; });\n\n  var wrapper = document.getElementById('na-stock-bar-wrapper');\n\n  function renderBar(qty, tracked) {\n    if (!tracked) { wrapper.innerHTML = ''; return; }\n\n    var state, text;\n    if (qty <= 0) {\n      state = 'soldout';\n      text  = '<strong>Udsolgt:</strong> 7\\u201310 dages levering.';\n    } else if (qty <= 3) {\n      state = 'critical';\n      text  = '<strong>Kun ' + qty + ' tilbage p\\u00e5 lager</strong> \\u2014 bestil nu for at sikre din.';\n    } else if (qty <= 8) {\n      state = 'low';\n      text  = '<strong>Popul\\u00e6r:</strong> Mange kigger p\\u00e5 dette nu &nbsp;\\u00b7&nbsp; <strong>Kun ' + qty + ' tilbage p\\u00e5 lager</strong>';\n    } else {\n      state = 'normal';\n      text  = '<strong>P\\u00e5 lager</strong> \\u2014 leveres dag til dag med GLS';\n    }\n\n    wrapper.innerHTML =\n      '<div class=\"na-stock-bar na-stock--' + state + '\">' +\n        '<span class=\"na-stock-dot\"></span>' +\n        '<span class=\"na-stock-text\">' + text + '</span>' +\n      '</div>';\n  }\n\n  // ── Listen for Shopify native variant change events ──\n  // Works with Horizon, Dawn, and most modern themes\n  document.addEventListener('variant:change', function (e) {\n    var variantId = e.detail && (e.detail.variant && e.detail.variant.id || e.detail.id);\n    if (!variantId) return;\n    var v = variantMap[variantId];\n    if (!v) return;\n    renderBar(v.inventory_quantity, v.inventory_management === 'shopify');\n  });\n\n  // ── Fallback: watch for URL param changes (older themes) ──\n  var lastVariantId = null;\n  function checkUrlVariant() {\n    var params = new URLSearchParams(window.location.search);\n    var id = parseInt(params.get('variant'), 10);\n    if (id && id !== lastVariantId && variantMap[id]) {\n      lastVariantId = id;\n      var v = variantMap[id];\n      renderBar(v.inventory_quantity, v.inventory_management === 'shopify');\n    }\n  }\n\n  // ── Fallback: MutationObserver on the add-to-cart button\n  //    (Horizon updates button data-variant-id when variant changes) ──\n  function watchAddToCartButton() {\n    var btn = document.querySelector('[name=\"id\"], [data-variant-id], #ProductSubmitButton, .product-form__submit');\n    if (!btn) return;\n    var observer = new MutationObserver(function () {\n      var id = parseInt(btn.value || btn.dataset.variantId, 10);\n      if (id && id !== lastVariantId && variantMap[id]) {\n        lastVariantId = id;\n        var v = variantMap[id];\n        renderBar(v.inventory_quantity, v.inventory_management === 'shopify');\n      }\n    });\n    observer.observe(btn, { attributes: true, attributeFilter: ['value', 'data-variant-id'] });\n  }\n\n  // ── Also listen on the hidden variant input directly ──\n  function watchVariantInput() {\n    var input = document.querySelector('input[name=\"id\"][form], form[action*=\"/cart/add\"] input[name=\"id\"]');\n    if (!input) return;\n    input.addEventListener('change', function () {\n      var id = parseInt(input.value, 10);\n      if (id && variantMap[id]) {\n        lastVariantId = id;\n        var v = variantMap[id];\n        renderBar(v.inventory_quantity, v.inventory_management === 'shopify');\n      }\n    });\n  }\n\n  document.addEventListener('DOMContentLoaded', function () {\n    watchAddToCartButton();\n    watchVariantInput();\n    // Poll URL as last-resort fallback\n    setInterval(checkUrlVariant, 400);\n  });\n\n  // If DOM already loaded\n  if (document.readyState !== 'loading') {\n    watchAddToCartButton();\n    watchVariantInput();\n    setInterval(checkUrlVariant, 400);\n  }\n})();\n</script>"
              },
              "blocks": {}
            },
