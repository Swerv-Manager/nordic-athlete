    "custom_liquid_gyLFRC": {
      "type": "custom-liquid",
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "<style>\n  /* ============================================================\n     NORDIC ATHLETE — HERO SEKTION\n     Indsæt denne kode i: Online Store → Customize → Add section → Custom Liquid\n     Ingen upload nødvendig — billeder er hostet eksternt\n  ============================================================ */\n\n  .na-hero {\n    background-color: #000000;\n    border-bottom: 1px solid #2e3d32;\n    overflow: hidden;\n    font-family: -apple-system, BlinkMacSystemFont, 'Inter', 'Segoe UI', sans-serif;\n  }\n  .na-hero-inner {\n    max-width: 1200px;\n    margin: 0 auto;\n    padding: 0 40px;\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    align-items: center;\n    min-height: 600px;\n  }\n  .na-hero-content {\n    padding: 64px 56px 64px 0;\n  }\n  .na-hero-eyebrow {\n    font-size: 10px;\n    font-weight: 800;\n    letter-spacing: 0.16em;\n    text-transform: uppercase;\n    color: #3d7a52;\n    margin-bottom: 20px;\n    display: inline-flex;\n    align-items: center;\n    gap: 10px;\n  }\n  .na-hero-eyebrow::before {\n    content: '';\n    display: block;\n    width: 24px;\n    height: 2px;\n    background: #3d7a52;\n    flex-shrink: 0;\n  }\n  .na-hero-title {\n    font-size: 62px;\n    font-weight: 900;\n    line-height: 1.0;\n    color: #ffffff;\n    margin: 0 0 20px 0;\n    letter-spacing: -0.02em;\n  }\n  .na-hero-title em {\n    font-style: normal;\n    color: #3d7a52;\n  }\n  .na-hero-subtitle {\n    font-size: 15px;\n    color: #7a8c80;\n    line-height: 1.75;\n    margin-bottom: 36px;\n    max-width: 400px;\n  }\n  .na-hero-cta {\n    display: flex;\n    gap: 12px;\n    flex-wrap: wrap;\n    margin-bottom: 44px;\n  }\n  .na-btn-primary {\n    background: #ffffff;\n    color: #131c15;\n    font-size: 11.5px;\n    font-weight: 800;\n    letter-spacing: 0.1em;\n    text-transform: uppercase;\n    padding: 14px 28px;\n    border-radius: 6px;\n    text-decoration: none;\n    display: inline-block;\n    transition: background 0.2s;\n  }\n  .na-btn-primary:hover { background: #4ecf6a; }\n  .na-btn-outline {\n    background: transparent;\n    color: #ffffff;\n    font-size: 11.5px;\n    font-weight: 800;\n    letter-spacing: 0.1em;\n    text-transform: uppercase;\n    padding: 13px 28px;\n    border-radius: 6px;\n    border: 1.5px solid #ffffff;\n    text-decoration: none;\n    display: inline-block;\n    transition: background 0.2s;\n  }\n  .na-btn-outline:hover { background: transparent; }\n  .na-hero-stats {\n    display: flex;\n    gap: 28px;\n    padding-top: 28px;\n    border-top: 1px solid #2e3d32;\n    flex-wrap: wrap;\n  }\n  .na-stat-val {\n    font-size: 22px;\n    font-weight: 900;\n    color: #ffffff;\n    line-height: 1;\n  }\n  .na-stat-lbl {\n    font-size: 9.5px;\n    font-weight: 700;\n    color: #4a5a4f;\n    letter-spacing: 0.12em;\n    text-transform: uppercase;\n    margin-top: 4px;\n  }\n  .na-hero-image-col {\n    position: relative;\n    height: 600px;\n    overflow: hidden;\n  }\n  .na-hero-image-col img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    object-position: center top;\n    display: block;\n  }\n  .na-hero-image-col::before {\n    content: '';\n    position: absolute;\n    left: 0;\n    top: 0;\n    bottom: 0;\n    width: 100px;\n    background: linear-gradient(to right, #1e2b23, transparent);\n    z-index: 1;\n    pointer-events: none;\n  }\n  .na-hero-badge {\n    position: absolute;\n    bottom: 24px;\n    right: 24px;\n    background: #000000;\n    border: 1px solid #2e3d32;\n    border-radius: 12px;\n    padding: 14px 16px;\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    z-index: 2;\n    backdrop-filter: blur(12px);\n    -webkit-backdrop-filter: blur(12px);\n    max-width: 220px;\n  }\n  .na-badge-icon {\n    width: 38px;\n    height: 38px;\n    background: #3d7a52;\n    border-radius: 50%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 17px;\n    flex-shrink: 0;\n  }\n  .na-badge-name {\n    font-size: 12px;\n    font-weight: 800;\n    color: #ffffff;\n    margin: 0;\n    line-height: 1.3;\n    letter-spacing: 0.02em;\n  }\n  .na-badge-sub {\n    font-size: 10.5px;\n    color: #5a6e60;\n    margin: 2px 0 0 0;\n  }\n  .na-badge-price {\n    font-size: 14px;\n    font-weight: 900;\n    color: #3d7a52;\n    margin: 5px 0 0 0;\n  }\n  .na-badge-price del {\n    font-size: 10.5px;\n    color: #4a5a4f;\n    font-weight: 400;\n    margin-right: 4px;\n  }\n\n  @media screen and (max-width: 900px) {\n    .na-hero-inner {\n      grid-template-columns: 1fr;\n      padding: 0 24px;\n    }\n    .na-hero-content {\n      padding: 40px 0 32px;\n    }\n    .na-hero-title {\n      font-size: 42px;\n    }\n    .na-hero-image-col {\n      height: 420px;\n    }\n    .na-hero-image-col::before {\n      display: none;\n    }\n  }\n</style>\n\n<section class=\"na-hero\">\n  <div class=\"na-hero-inner\">\n\n    <div class=\"na-hero-content\">\n      <div class=\"na-hero-eyebrow\">Officiel partner · Gamepatch & Høj Elitehåndbold</div>\n      <h2 class=\"na-hero-title\">Beskyt<br>din <em>krop.</em><br>Spil frit.</h2>\n      <p class=\"na-hero-subtitle\">Professionelt beskyttelsesudstyr udviklet i samarbejde med eliteatleter. Fordi din krop skal holde i mange år — sæson efter sæson.</p>\n      <div class=\"na-hero-cta\">\n        <a href=\"/collections/gamepatch-1\" class=\"na-btn-primary\">🛒 Shop GAMEPATCH</a>\n        <a href=\"/collections\" class=\"na-btn-outline\">Vælg din sport</a>\n      </div>\n      <div class=\"na-hero-stats\">\n        <!-- stat-items indsættes her -->\n      </div>\n    </div><!-- ✅ lukker .na-hero-content -->\n\n    <div class=\"na-hero-image-col\">\n      <img\n        src=\"https://files.manuscdn.com/user_upload_by_module/session_file/310519663475368793/bDTCqejYeANNHOMM.jpg\"\n        alt=\"Magnus Stilling i GAMEPATCH udstyr\"\n        loading=\"eager\"\n      >\n      <div class=\"na-hero-badge\">\n        <div class=\"na-badge-icon\">🏆</div>\n        <div>\n          <p class=\"na-badge-name\">Dainis Kristopans</p>\n          <p class=\"na-badge-sub\">Professionel håndboldspiller</p>\n          <p class=\"na-badge-sub\">MT Melsungen, Tyskland</p>\n        </div>\n      </div>\n    </div><!-- ✅ lukker .na-hero-image-col -->\n\n  </div><!-- ✅ lukker .na-hero-inner -->\n</section>",
        "color_scheme": "scheme-2",
        "section_width": "page-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    },
    "custom_liquid_8apW9d": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "<style>\n  /* ============================================================\n     NORDIC ATHLETE — TRUST BAR\n     Indsæt denne kode i: Online Store → Customize → Add section → Custom Liquid\n     Placeres direkte under Hero-sektionen\n  ============================================================ */\n\n  .na-trust-bar {\n    background: #000000;\n    border-bottom: 1px solid #2e3d32;\n    font-family: -apple-system, BlinkMacSystemFont, 'Inter', 'Segoe UI', sans-serif;\n  }\n  .na-trust-inner {\n    max-width: 1200px;\n    margin: 0 auto;\n    padding: 0 40px;\n    display: flex;\n    align-items: center;\n    height: 52px;\n  }\n  .na-trust-item {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    flex: 1;\n    justify-content: center;\n    padding: 0 16px;\n  }\n  .na-trust-item + .na-trust-item {\n    border-left: 1px solid #2e3d32;\n  }\n  .na-trust-icon {\n    font-size: 14px;\n    flex-shrink: 0;\n    line-height: 1;\n  }\n  .na-trust-text {\n    font-size: 11px;\n    font-weight: 600;\n    color: #7a8c80;\n    white-space: nowrap;\n    letter-spacing: 0.01em;\n  }\n  .na-trust-text strong {\n    color: #e8ede9;\n    font-weight: 700;\n  }\n\n  @media screen and (max-width: 768px) {\n    .na-trust-inner {\n      overflow-x: auto;\n      -webkit-overflow-scrolling: touch;\n      scrollbar-width: none;\n      padding: 0 16px;\n      gap: 0;\n    }\n    .na-trust-inner::-webkit-scrollbar { display: none; }\n    .na-trust-item {\n      flex-shrink: 0;\n      padding: 0 20px;\n    }\n  }\n</style>\n\n<div class=\"na-trust-bar\">\n  <div class=\"na-trust-inner\">\n    <div class=\"na-trust-item\">\n      <span class=\"na-trust-icon\">🚚</span>\n      <span class=\"na-trust-text\"><strong>Dag til dag levering</strong> på lagervarer</span>\n    </div>\n    <div class=\"na-trust-item\">\n      <span class=\"na-trust-icon\">↩️</span>\n      <span class=\"na-trust-text\"><strong>30 dages</strong> returret</span>\n    </div>\n    <div class=\"na-trust-item\">\n      <span class=\"na-trust-icon\">🇪🇺</span>\n      <span class=\"na-trust-text\"><strong>Håndlavet</strong> i Europa</span>\n    </div>\n    <div class=\"na-trust-item\">\n      <span class=\"na-trust-icon\">🔒</span>\n      <span class=\"na-trust-text\"><strong>Sikker betaling</strong> — Visa, MobilePay, Apple Pay</span>\n    </div>\n    <div class=\"na-trust-item\">\n      <span class=\"na-trust-icon\">⭐</span>\n      <span class=\"na-trust-text\">Vurderet <strong>4.9/5</strong> af 200+ kunder</span>\n    </div>\n  </div>\n</div>",
        "color_scheme": "",
        "section_width": "full-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
