    "custom_liquid_wNACmq": {
      "type": "custom-liquid",
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "<style>\n  /* ============================================================\n     NORDIC ATHLETE — TEAM SEKTION (Jonas & John)\n     Indsæt denne kode i: Online Store → Customize → Add section → Custom Liquid\n     Placeres mod bunden af forsiden, før footer\n  ============================================================ */\n\n  .na-team {\n    padding: 80px 40px;\n    background: #2a2a2a;\n    border-top: 1px solid #2e3d32;\n    font-family: -apple-system, BlinkMacSystemFont, 'Inter', 'Segoe UI', sans-serif;\n  }\n  .na-team-inner {\n    max-width: 1200px;\n    margin: 0 auto;\n  }\n  .na-team-header {\n    max-width: 540px;\n    margin-bottom: 48px;\n  }\n  .na-team-eyebrow {\n    font-size: 10px;\n    font-weight: 800;\n    letter-spacing: 0.16em;\n    text-transform: uppercase;\n    color: #3d7a52;\n    margin: 0 0 10px 0;\n    display: inline-flex;\n    align-items: center;\n    gap: 10px;\n  }\n  .na-team-eyebrow::before {\n    content: '';\n    display: block;\n    width: 24px;\n    height: 2px;\n    background: #3d7a52;\n    flex-shrink: 0;\n  }\n  .na-team-title {\n    font-size: 38px;\n    font-weight: 900;\n    line-height: 1.1;\n    color: #ffffff;\n    margin: 0 0 14px 0;\n    letter-spacing: -0.02em;\n  }\n  .na-team-title em {\n    font-style: normal;\n    color: #3d7a52;\n  }\n  .na-team-subtitle {\n    font-size: 14.5px;\n    color: #7a8c80;\n    line-height: 1.75;\n    margin: 0;\n  }\n  .na-team-grid {\n    display: grid;\n    grid-template-columns: repeat(2, 1fr);\n    gap: 16px;\n  }\n  .na-team-card {\n    background: #000000;\n    border: 1px solid #2e3d32;\n    border-radius: 12px;\n    overflow: hidden;\n    display: grid;\n    grid-template-columns: 200px 1fr;\n    transition: border-color 0.2s;\n  }\n  .na-team-card:hover {\n    border-color: #3a5040;\n  }\n  .na-team-photo {\n    width: 100%;\n    height: 100%;\n    min-height: 260px;\n    object-fit: cover;\n    object-position: center top;\n    display: block;\n  }\n  .na-team-info {\n    padding: 28px 24px;\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n  }\n  .na-team-name {\n    font-size: 20px;\n    font-weight: 900;\n    color: #ffffff;\n    margin: 0 0 4px 0;\n    letter-spacing: -0.01em;\n  }\n  .na-team-role {\n    font-size: 9.5px;\n    font-weight: 800;\n    letter-spacing: 0.14em;\n    text-transform: uppercase;\n    color: #3d7a52;\n    margin: 0 0 14px 0;\n  }\n  .na-team-bio {\n    font-size: 13.5px;\n    color: #7a8c80;\n    line-height: 1.7;\n    margin: 0;\n  }\n  .na-team-bio em {\n    font-style: italic;\n    color: #a0b0a6;\n  }\n\n  @media screen and (max-width: 960px) {\n    .na-team-grid {\n      grid-template-columns: 1fr;\n    }\n  }\n  @media screen and (max-width: 600px) {\n    .na-team {\n      padding: 56px 24px;\n    }\n    .na-team-card {\n      grid-template-columns: 1fr;\n    }\n    .na-team-photo {\n      height: 280px;\n      min-height: auto;\n    }\n    .na-team-title {\n      font-size: 28px;\n    }\n  }\n</style>\n\n<section class=\"na-team\">\n  <div class=\"na-team-inner\">\n\n    <div class=\"na-team-header\">\n      <p class=\"na-team-eyebrow\">Folkene bag</p>\n      <h2 class=\"na-team-title\">Menneskerne bag <em>brandet</em></h2>\n      <p class=\"na-team-subtitle\">Vi har nøje udvalgt et sortiment af produkter fra førende mærker og producenter, der deler vores vision om kvalitet og ydeevne — sæson efter sæson.</p>\n    </div>\n\n    <div class=\"na-team-grid\">\n\n      <div class=\"na-team-card\">\n        <img\n          class=\"na-team-photo\"\n          src=\"https://files.manuscdn.com/user_upload_by_module/session_file/310519663475368793/lQOcHBWevwTTurzP.webp\"\n          alt=\"Jonas Ostenfeldt\"\n          loading=\"lazy\"\n        >\n        <div class=\"na-team-info\">\n          <h3 class=\"na-team-name\">Jonas Ostenfeldt</h3>\n          <p class=\"na-team-role\">Ejer & Daglig Leder</p>\n          <p class=\"na-team-bio\">Jonas ejer Nordic-Athlete og er aktiv i hele det daglige arbejde. <em>\"For mig handler NORDIC ATHLETE om ærlighed, kvalitet og løsninger, der faktisk gør en forskel. Jeg har et ønske om at vi skal passe bedre på vores kroppe!\"</em></p>\n        </div>\n      </div>\n\n      <div class=\"na-team-card\">\n        <img\n          class=\"na-team-photo\"\n          src=\"https://files.manuscdn.com/user_upload_by_module/session_file/310519663475368793/yQCiPeEJtiOUSkzh.png\"\n          alt=\"John Stilling\"\n          loading=\"lazy\"\n        >\n        <div class=\"na-team-info\">\n          <h3 class=\"na-team-name\">John Stilling</h3>\n          <p class=\"na-team-role\">Produktansvarlig & Sportsbindeled</p>\n          <p class=\"na-team-bio\">John er en del af NORDIC ATHLETE og er aktiv omkring produkter og bindeled imellem os og sportsmiljøerne. <em>\"For mig handler sport ikke kun om præstation her og nu, men om at kunne blive ved og præstere i mange år.\"</em></p>\n        </div>\n      </div>\n\n    </div>\n  </div>\n</section>",
        "color_scheme": "scheme-1",
        "section_width": "full-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    }
