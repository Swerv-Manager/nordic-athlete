    "custom_liquid_mbQhJw": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "<!-- ═══════════════════════════════════════════════════════════════\n     NA PAGE: Ofte Stillede Spørgsmål (FAQ)\n     Brug: Custom Liquid block på en Shopify Page (pages/faq)\n     Erstatter: Den eksisterende FAQ-side med ny brand-stil\n     ═══════════════════════════════════════════════════════════════ -->\n\n<style>\n  /* ── Page wrapper ── */\n  .na-faq {\n    max-width: 780px;\n    margin: 0 auto;\n    padding: 48px 20px 64px;\n    font-family: inherit;\n    color: #a8b8ae;\n  }\n\n  /* ── Page title ── */\n  .na-faq-title {\n    font-size: 11px;\n    font-weight: 800;\n    letter-spacing: 0.18em;\n    text-transform: uppercase;\n    color: #5ab87a;\n    text-align: center;\n    margin: 0 0 6px 0;\n  }\n  .na-faq-heading {\n    font-size: clamp(26px, 5vw, 40px);\n    font-weight: 900;\n    letter-spacing: -0.01em;\n    color: #ffffff;\n    text-align: center;\n    margin: 0 0 12px 0;\n    line-height: 1.15;\n  }\n  .na-faq-intro {\n    font-size: 14px;\n    color: #6a7a70;\n    text-align: center;\n    margin: 0 0 48px 0;\n    line-height: 1.6;\n  }\n  .na-faq-intro a {\n    color: #5ab87a;\n    text-decoration: none;\n  }\n  .na-faq-intro a:hover {\n    text-decoration: underline;\n  }\n\n  /* ── Category group ── */\n  .na-faq-group {\n    margin-bottom: 40px;\n  }\n  .na-faq-group-label {\n    font-size: 9.5px;\n    font-weight: 800;\n    letter-spacing: 0.2em;\n    text-transform: uppercase;\n    color: #5ab87a;\n    margin: 0 0 4px 2px;\n  }\n  .na-faq-group-title {\n    font-size: 18px;\n    font-weight: 800;\n    letter-spacing: 0.02em;\n    color: #ffffff;\n    margin: 0 0 16px 0;\n    padding-bottom: 12px;\n    border-bottom: 1px solid #2e3d32;\n  }\n\n  /* ── Accordion ── */\n  .na-faq-accordion {\n    display: flex;\n    flex-direction: column;\n    gap: 0;\n  }\n  .na-faq-item {\n    border: 1px solid #2e3d32;\n    border-radius: 0;\n    overflow: hidden;\n  }\n  .na-faq-item:first-child { border-radius: 8px 8px 0 0; }\n  .na-faq-item:last-child  { border-radius: 0 0 8px 8px; }\n  .na-faq-item + .na-faq-item { border-top: none; }\n\n  .na-faq-item summary {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 12px;\n    padding: 15px 18px;\n    background-color: #1a2a1f;\n    cursor: pointer;\n    list-style: none;\n    font-size: 12px;\n    font-weight: 700;\n    letter-spacing: 0.07em;\n    text-transform: uppercase;\n    color: #c8d8ce;\n    transition: background-color 0.15s, color 0.15s;\n    user-select: none;\n    line-height: 1.4;\n  }\n  .na-faq-item summary::-webkit-details-marker { display: none; }\n  .na-faq-item summary::marker { display: none; }\n  .na-faq-item summary:hover {\n    background-color: #253020;\n    color: #ffffff;\n  }\n  .na-faq-item[open] > summary {\n    background-color: #253020;\n    color: #5ab87a;\n    border-bottom: 1px solid #2e3d32;\n  }\n\n  .na-faq-chevron {\n    width: 16px;\n    height: 16px;\n    flex-shrink: 0;\n    transition: transform 0.2s ease;\n    color: currentColor;\n    opacity: 0.7;\n  }\n  .na-faq-item[open] .na-faq-chevron {\n    transform: rotate(180deg);\n    opacity: 1;\n  }\n\n  .na-faq-body {\n    background-color: #131c15;\n    padding: 16px 20px 18px;\n    font-size: 14px;\n    color: #a8b8ae;\n    line-height: 1.75;\n    border-top: none;\n  }\n  .na-faq-body p { margin: 0 0 10px; }\n  .na-faq-body p:last-child { margin-bottom: 0; }\n  .na-faq-body a { color: #5ab87a; text-decoration: none; }\n  .na-faq-body a:hover { text-decoration: underline; }\n  .na-faq-body strong { color: #ffffff; }\n  .na-faq-body ul {\n    margin: 8px 0; padding-left: 0; list-style: none;\n  }\n  .na-faq-body ul li {\n    padding: 3px 0; display: flex; align-items: flex-start; gap: 8px;\n  }\n\n  /* ── Contact CTA at bottom ── */\n  .na-faq-cta {\n    margin-top: 48px;\n    padding: 24px 28px;\n    background: #1a2a1f;\n    border: 1px solid #2e3d32;\n    border-radius: 12px;\n    text-align: center;\n  }\n  .na-faq-cta p {\n    font-size: 14px;\n    color: #a8b8ae;\n    margin: 0 0 16px 0;\n    line-height: 1.6;\n  }\n  .na-faq-cta p strong { color: #ffffff; }\n  .na-faq-cta-btn {\n    display: inline-block;\n    background: #2d5a3d;\n    color: #ffffff;\n    font-size: 12px;\n    font-weight: 700;\n    letter-spacing: 0.1em;\n    text-transform: uppercase;\n    text-decoration: none;\n    padding: 12px 28px;\n    border-radius: 6px;\n    border: 1px solid #3d7a52;\n    transition: background-color 0.15s;\n  }\n  .na-faq-cta-btn:hover {\n    background: #3d7a52;\n  }\n</style>\n\n<div class=\"na-faq\">\n\n  <!-- Page header -->\n  <!-- NOTE: Shopify renders the page title (h1) automatically above this block.\n       The intro paragraph below sits directly under that title. -->\n  <p class=\"na-faq-intro\" style=\"text-align:center;margin-bottom:40px;\">Find svar på de mest almindelige spørgsmål herunder. Finder du ikke det du søger, er du altid velkommen til at kontakte os på <a href=\"mailto:support@nordic-athlete.dk\">support@nordic-athlete.dk</a>.</p>\n\n  <!-- ── KATEGORI 1: Bestilling og betaling ── -->\n  <div class=\"na-faq-group\">\n    <p class=\"na-faq-group-label\">01 — Bestilling</p>\n    <h2 class=\"na-faq-group-title\">Bestilling og betaling</h2>\n    <div class=\"na-faq-accordion\">\n\n      <details class=\"na-faq-item\">\n        <summary>\n          Vil jeg modtage ordrebekræftelse?\n          <svg class=\"na-faq-chevron\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"6 9 12 15 18 9\"/></svg>\n        </summary>\n        <div class=\"na-faq-body\">\n          <p>Når du har afgivet en ordre, vil du snarest modtage en bekræftelsesmail. Tjek venligst din spam-mappe. Hvis du ikke har modtaget din ordrebekræftelse, bedes du kontakte kundesupporten på <a href=\"mailto:support@nordic-athlete.dk\">support@nordic-athlete.dk</a>.</p>\n        </div>\n      </details>\n\n      <details class=\"na-faq-item\">\n        <summary>\n          Kan jeg ændre eller annullere min ordre efter at have afgivet den?\n          <svg class=\"na-faq-chevron\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"6 9 12 15 18 9\"/></svg>\n        </summary>\n        <div class=\"na-faq-body\">\n          <p>Når en ordre er afgivet, begynder vi at behandle den med det samme. Hvis du har brug for at foretage ændringer, bedes du kontakte os hurtigst muligt. Selvom vi ikke kan garantere, at ændringerne er mulige, vil vi gøre vores bedste for at hjælpe dig.</p>\n        </div>\n      </details>\n\n      <details class=\"na-faq-item\">\n        <summary>\n          Hvorfor blev min betaling afvist?\n          <svg class=\"na-faq-chevron\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"6 9 12 15 18 9\"/></svg>\n        </summary>\n        <div class=\"na-faq-body\">\n          <p>Betalingsfejl kan forekomme på grund af forkerte oplysninger, utilstrækkelige midler eller sikkerhedsindstillinger. Prøv at bruge en anden betalingsmetode, eller kontakt din bank for at få hjælp.</p>\n        </div>\n      </details>\n\n    </div>\n  </div>\n\n  <!-- ── KATEGORI 2: Forsendelse og levering ── -->\n  <div class=\"na-faq-group\">\n    <p class=\"na-faq-group-label\">02 — Levering</p>\n    <h2 class=\"na-faq-group-title\">Forsendelse og levering</h2>\n    <div class=\"na-faq-accordion\">\n\n      <details class=\"na-faq-item\">\n        <summary>\n          Hvad er leveringstiden for min ordre?\n          <svg class=\"na-faq-chevron\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"6 9 12 15 18 9\"/></svg>\n        </summary>\n        <div class=\"na-faq-body\">\n          <ul>\n            <li>📦 <strong>Ordrebehandling:</strong> 0–1 hverdag</li>\n            <li>🚚 <strong>Transittid:</strong> 1–2 hverdage</li>\n            <li>✅ <strong>Samlet leveringstid:</strong> 1–3 hverdage</li>\n          </ul>\n          <p>Gratis levering ved køb over 499 kr. Levering via GLS eller PostNord til pakkeboks eller hjemmeadresse.</p>\n        </div>\n      </details>\n\n      <details class=\"na-faq-item\">\n        <summary>\n          Kan jeg spore min ordre?\n          <svg class=\"na-faq-chevron\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"6 9 12 15 18 9\"/></svg>\n        </summary>\n        <div class=\"na-faq-body\">\n          <p>Ja! Når varen er blevet afsendt, modtager du et sporingsnummer via e-mail, som du kan bruge til at spore din ordre direkte hos fragtmanden.</p>\n        </div>\n      </details>\n\n      <details class=\"na-faq-item\">\n        <summary>\n          Hvad skal jeg gøre, hvis min ordre ikke er ankommet?\n          <svg class=\"na-faq-chevron\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"6 9 12 15 18 9\"/></svg>\n        </summary>\n        <div class=\"na-faq-body\">\n          <p>Hvis din ordre er forsinket eller ikke er ankommet inden for den forventede tid, bedes du kontakte vores supportteam på <a href=\"mailto:support@nordic-athlete.dk\">support@nordic-athlete.dk</a>, så hjælper vi dig gerne.</p>\n        </div>\n      </details>\n\n    </div>\n  </div>\n\n  <!-- ── KATEGORI 3: Returnering og refusion ── -->\n  <div class=\"na-faq-group\">\n    <p class=\"na-faq-group-label\">03 — Returnering</p>\n    <h2 class=\"na-faq-group-title\">Returnering og refusion</h2>\n    <div class=\"na-faq-accordion\">\n\n      <details class=\"na-faq-item\">\n        <summary>\n          Hvad er jeres returpolitik?\n          <svg class=\"na-faq-chevron\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"6 9 12 15 18 9\"/></svg>\n        </summary>\n        <div class=\"na-faq-body\">\n          <p>Vi tilbyder <strong>30 dages returret</strong> fra modtagelsesdato. Varer skal returneres i original stand og emballage.</p>\n          <p>Bemærk: Returlabel udstedes kun ved reklamationer og garantisager. Ved øvrige returneringer betaler kunden selv fragtomkostningerne.</p>\n        </div>\n      </details>\n\n      <details class=\"na-faq-item\">\n        <summary>\n          Hvad skal jeg gøre, hvis jeg modtager et beskadiget produkt?\n          <svg class=\"na-faq-chevron\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"6 9 12 15 18 9\"/></svg>\n        </summary>\n        <div class=\"na-faq-body\">\n          <p>Hvis du modtager en beskadiget eller defekt vare, bedes du straks kontakte os på <a href=\"mailto:support@nordic-athlete.dk\">support@nordic-athlete.dk</a> med detaljer og billeder af problemet. Vi vil arbejde på at løse problemet hurtigst muligt og sørge for, at du modtager en returlabel.</p>\n        </div>\n      </details>\n\n      <details class=\"na-faq-item\">\n        <summary>\n          Hvornår modtager jeg min refusion?\n          <svg class=\"na-faq-chevron\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"6 9 12 15 18 9\"/></svg>\n        </summary>\n        <div class=\"na-faq-body\">\n          <p>Når vi har modtaget og inspiceret din returnering, sender vi dig en e-mail med besked om godkendelse eller afvisning af din refusion.</p>\n          <p>Hvis din returnering godkendes, vil refusionen blive behandlet og krediteret til din oprindelige betalingsmetode inden for <strong>9 hverdage</strong>.</p>\n        </div>\n      </details>\n\n    </div>\n  </div>\n\n  <!-- ── KATEGORI 4: Konto og kundesupport ── -->\n  <div class=\"na-faq-group\">\n    <p class=\"na-faq-group-label\">04 — Support</p>\n    <h2 class=\"na-faq-group-title\">Konto og kundesupport</h2>\n    <div class=\"na-faq-accordion\">\n\n      <details class=\"na-faq-item\">\n        <summary>\n          Skal jeg have en konto for at afgive en ordre?\n          <svg class=\"na-faq-chevron\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"6 9 12 15 18 9\"/></svg>\n        </summary>\n        <div class=\"na-faq-body\">\n          <p>Nej, du kan gennemføre dit køb som gæst uden at oprette en konto. Ønsker du at følge dine ordrer og gemme dine oplysninger til fremtidige køb, kan du oprette en gratis konto.</p>\n        </div>\n      </details>\n\n      <details class=\"na-faq-item\">\n        <summary>\n          Hvordan kan jeg kontakte kundesupport?\n          <svg class=\"na-faq-chevron\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"6 9 12 15 18 9\"/></svg>\n        </summary>\n        <div class=\"na-faq-body\">\n          <p>Du kan kontakte vores supportteam via:</p>\n          <ul>\n            <li>📧 <strong>E-mail:</strong> <a href=\"mailto:support@nordic-athlete.dk\">support@nordic-athlete.dk</a></li>\n            <li>📋 <strong>Kontaktformular:</strong> <a href=\"/pages/contact\">Klik her for at sende en besked</a></li>\n          </ul>\n          <p>Vi bestræber os på at svare inden for <strong>24 timer</strong> på hverdage (mandag–fredag kl. 9–15).</p>\n        </div>\n      </details>\n\n    </div>\n  </div>\n\n  <!-- ── Contact CTA ── -->\n  <div class=\"na-faq-cta\">\n    <p><strong>Fandt du ikke svar på dit spørgsmål?</strong><br>Vores supportteam er klar til at hjælpe dig — vi svarer inden for 24 timer.</p>\n    <a href=\"/pages/contact\" class=\"na-faq-cta-btn\">Kontakt os</a>\n  </div>\n\n</div>",
        "color_scheme": "",
        "section_width": "page-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    }
  },
